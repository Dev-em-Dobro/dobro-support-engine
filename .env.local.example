# Copie para .env.local e preencha:
#   cp .env.local.example .env.local

# ── Obrigatórias pra o app funcionar ──────────────────────────────────────────
# Connection string do Neon (use a URL do pooler, com sslmode=require).
# Crie um projeto em https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Segredo JWT da sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=

# ── Recomendadas em local ─────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# true = magic link aparece na tela (sem enviar email)
DOBRO_DEV_MODE=true

# Seed de usuários de DEV (pnpm drizzle:seed). Pulado se vazio.
SEED_DEV_GESTOR_EMAIL=gestor@local.test
SEED_DEV_VENDEDOR_EMAIL=vendedor@local.test
SEED_DEV_PASSWORD=dev-password-change-me
# Opcional: senhas distintas por papel
# SEED_DEV_GESTOR_PASSWORD=
# SEED_DEV_VENDEDOR_PASSWORD=

# ── IA / GitHub (correção automática e agente de vendas) ──────────────────────
OPENAI_API_KEY=
GITHUB_TOKEN=

# ── Integrações opcionais ─────────────────────────────────────────────────────
# Email (desligado por padrão; login em DEV usa o link na tela)
# DOBRO_EMAIL_ENABLED=false
# RESEND_API_KEY=
# FROM_EMAIL=Dobro Support <onboarding@resend.dev>

# Dashboard Scudo (métricas Neon de outro projeto)
# SCUDO_DATABASE_URL=
# SCUDO_NEON_PROJECT_ID=
# NEON_NAPI_KEY=
# NEON_ORG_ID=

# 2FA: chave de cifra dos secrets TOTP (default = AUTH_SECRET)
# TOTP_ENC_KEY=

# Cron da Vercel
# CRON_SECRET=

# Alertas do agente de vendas (Slack/Discord)
# SALES_ALERT_WEBHOOK=
# SALES_CONTEXT_REQUIRE_APPROVAL=false
# SALES_EVAL_AUTO=false
